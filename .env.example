# Скопируйте строку пароля командой: npm run set-password (она сама создаст .env)
ADMIN_PASSWORD_HASH=

# Порт сервера (по умолчанию 3000)
PORT=3000

# Адрес сайта после публикации — для sitemap и превью в соцсетях
# PUBLIC_URL=https://amrel.ru

# Если сайт работает за прокси (Nginx, Render, Railway) — включите:
# TRUST_PROXY=true
# COOKIE_SECURE=true

# Папка для базы и загруженных фото (на хостинге — постоянный диск)
# DATA_DIR=/var/data/amrel
