{
  "name": "amrel-store",
  "version": "1.0.0",
  "private": true,
  "description": "AMREL — премиальный интернет-магазин одежды",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "node scripts/build.mjs --watch & node --watch --disable-warning=ExperimentalWarning server/index.mjs",
    "build": "node scripts/build.mjs && node scripts/build-vercel.mjs",
    "set-password": "node scripts/set-password.mjs",
    "preview": "node --disable-warning=ExperimentalWarning scripts/build-preview.mjs",
    "test": "node --disable-warning=ExperimentalWarning scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  }
}
